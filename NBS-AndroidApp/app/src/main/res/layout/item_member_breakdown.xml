<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/modern_member_card_background"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Member Pill at top of card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/memberPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/modern_member_pill_active_background"
                android:text="MEMBER"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Enhanced Header with member name and modern copy button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:id="@+id/memberAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/modern_avatar_background">

                <TextView
                    android:id="@+id/memberEmoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="😀"
                    android:textSize="24sp" />

            </FrameLayout>

            <TextView
                android:id="@+id/memberName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Member Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:letterSpacing="0.05" />

            <ImageButton
                android:id="@+id/copyButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/modern_copy_button_background"
                android:src="@drawable/ic_copy"
                android:contentDescription="Copy amount"
                android:padding="12dp"
                android:tint="@color/white" />

        </LinearLayout>

        <!-- Enhanced Amount breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/modern_amount_background"
            android:padding="12dp">

            <TextView
                android:id="@+id/subtotalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtotal: £0.00"
                style="@style/TextStyle.OnOcean.Medium" />

            <TextView
                android:id="@+id/discountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discount: -£0.00"
                style="@style/TextStyle.OnOcean.Medium" />

            <TextView
                android:id="@+id/finalAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Final: £0.00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_ocean_emphasis"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Enhanced Items list -->
        <TextView
            android:id="@+id/itemsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Items: None"
            style="@style/TextStyle.OnOcean.Small"
            android:background="@drawable/modern_items_background"
            android:padding="10dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView> 