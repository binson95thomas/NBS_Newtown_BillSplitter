<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/background_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Item Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/itemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Item Name"
                    style="@style/TextStyle.ItemName.OnOcean" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:id="@+id/itemPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="£0.00"
                        style="@style/TextStyle.ItemPrice.OnOcean" />
                    <TextView
                        android:id="@+id/itemConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="95%"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:background="@drawable/badge_ok"
                        android:visibility="gone"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/splitEvenlyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:text="Split Evenly"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:elevation="4dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:gravity="center"
                        style="@style/Widget.Material3.Button"
                        android:background="@drawable/split_evenly_button_background"
                        app:icon="@drawable/ic_people"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/voucherToggleButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:text="📉 Discount"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:elevation="4dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:gravity="center"
                        style="@style/Widget.Material3.Button"
                        android:backgroundTint="#64748B"
                        app:cornerRadius="18dp"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageButton
                    android:id="@+id/editItemButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circular_button_background"
                    android:contentDescription="Edit item"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/accent_500" />
                <ImageButton
                    android:id="@+id/deleteItemButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circular_button_background"
                    android:contentDescription="Delete item"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/error_500" />
            </LinearLayout>
        </LinearLayout>

        <!-- Member Assignment Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="👥 Assigned to:"
                style="@style/TextStyle.MemberAssignment" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/memberCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:alignItems="center"
                app:alignContent="flex_start"
                android:layout_marginTop="-4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView> 