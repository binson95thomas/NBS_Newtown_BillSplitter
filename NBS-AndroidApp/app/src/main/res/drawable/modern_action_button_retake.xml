<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#60FF8800" />
            <size android:width="68dp" android:height="68dp" />
        </shape>
    </item>
    
    <!-- Main button background with gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:startColor="#FFB347"
                android:centerColor="#FF8C00"
                android:endColor="#FF6347" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
    
    <!-- Inner highlight -->
    <item android:gravity="top">
        <shape android:shape="oval">
            <solid android:color="#30FFFFFF" />
            <size android:width="64dp" android:height="64dp" />
            <padding android:top="3dp" />
        </shape>
    </item>
    
</layer-list>
