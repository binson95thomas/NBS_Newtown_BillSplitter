<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4008B5A3" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Main gradient background -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#8B5CF6"
                android:centerColor="#7C3AED"
                android:endColor="#6D28D9" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    
    <!-- Inner highlight -->
    <item android:left="4dp" android:top="4dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
